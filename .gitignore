# ==========================================================
#  showDown — Unity .gitignore
#  Unity 6.3 LTS (6000.3.x)
# ==========================================================

# Unity 생성 폴더 (절대 커밋 금지)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store 다운로드 캐시
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 빌드 산출물
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.pdb

# Crashlytics
crashlytics-build.properties

# Unity Packages 잠금 파일
#  → 강의 중 버전 드리프트를 막기 위해 커밋한다. 삭제하지 말 것.
!/[Pp]ackages/packages-lock.json

# MCP for Unity 로컬 상태
/[Aa]ssets/MCPForUnity/Editor/Data/
*.mcp-local.json

# Claude Code 로컬 설정 (개인 설정은 커밋하지 않음)
.claude/settings.local.json

# 학생 개인 작업 메모
/scratch/
/_personal/

# ==========================================================
#  라이선스 에셋 (공개 저장소에 올리지 않는다)
#  Asset Store 에셋은 재배포가 금지되어 있다. 팀원은 각자 임포트한다.
# ==========================================================
/[Aa]ssets/Codematik/
/[Aa]ssets/Codematik.meta
/[Aa]ssets/InfiniteCharacterForgeWildWest/
/[Aa]ssets/InfiniteCharacterForgeWildWest.meta

# 위 에셋의 그림에서 잘라 만든 가공본(건물 이미지)
/[Aa]ssets/Sprites/Buildings/
/[Aa]ssets/Sprites/Buildings.meta

# 확인용 임시 스크린샷
/[Aa]ssets/Screenshots/
/[Aa]ssets/Screenshots.meta

# 내 PC 경로가 들어간 MCP 설정
/.mcp.json

# 생성 이미지로 만든 상점창 프레임
/[Aa]ssets/Sprites/UI/StoreFrame.png
/[Aa]ssets/Sprites/UI/StoreFrame.png.meta

# 외부 폰트(Galmuri, OFL-1.1)
/[Aa]ssets/Fonts/
/[Aa]ssets/Fonts.meta
